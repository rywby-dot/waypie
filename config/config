[[menu.items.items]]
label = "Lock"
keys = "2w"
command = "(command -v swaylock >/dev/null 2>&1 && swaylock -f -c 000000) || (command -v gtklock >/dev/null 2>&1 && gtklock) || (command -v waylock >/dev/null 2>&1 && waylock) || loginctl lock-session \"$XDG_SESSION_ID\""
