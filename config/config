[[menu.items.items.items]]
label = "Quit"
keys = "2w"
command = "([ -n \"$XDG_SESSION_ID\" ] && loginctl terminate-session \"$XDG_SESSION_ID\") || (command -v driftwm >/dev/null 2>&1 && driftwm msg action quit) || (command -v swaymsg >/dev/null 2>&1 && swaymsg exit) || (command -v niri >/dev/null 2>&1 && niri msg action quit) || (command -v hyprctl >/dev/null 2>&1 && hyprctl dispatch exit) || (command -v riverctl >/dev/null 2>&1 && riverctl exit)"
icon-theme = "tabler-icons"
icon = "outline/door-exit.svg"
angle = 108

