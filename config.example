# This is config.example.
# You don't need to change it!
# Open GUI editor waypie-editor ant setup everything there
# just copy in to ~/.config
#   cp config.example ~/.config/waypie/config
#   cp style.example.css ~/.config/waypie/style.css
# and read README.md
# https://github.com/rywby-dot/waypie
# Colors are setup manually in style.css

menu-radius = 120
center-hitbox-size = 160
minimum-edge-distance = 200
center-mode = false
active-label-in-center = true
close-submenu-on-center-click = false
hover-mode = false
turbo-mode = true
preserve-proportions = true
auto-alignment = true
configurator-show-icons = true

[menu]
label = "Waypie"
icon-theme = "Papirus-Dark"
icon = "16x16/actions/atmosphere.svg"

[[menu.items]]
label = "Scripts"
icon-theme = "Papirus-Dark"
icon = "16x16/actions/amarok_scripts.svg"
angle = 288

[[menu.items.items]]
label = "Driftwm Config"
command = "footclient env QUIET_START=1 zsh -ic 'nvim ~/.config/driftwm/config.toml; unset QUIET_START'"
icon-theme = "Papirus-Dark"
icon = "24x24/actions/configure_toolbars.svg"
angle = 55

[[menu.items.items]]
label = "Driftwm State"
command = "footclient zsh -c 'cat $XDG_RUNTIME_DIR/driftwm/state; exec zsh'"
icon-theme = "Papirus-Dark"
icon = "16x16/actions/view-statistics.svg"
angle = 260

[[menu.items.items]]
label = "Fetch"
command = "footclient -a foot-ff zsh -c 'fastfetch -c screenfetch.jsonc && sleep 9999'"
icon-theme = "tabler-icons"
icon = "outline/info-circle.svg"
angle = 312

[[menu.items.items]]
label = "Screen Shots"
command = "ls -dt /home/rywby/Pictures/Screenshots/* | xargs -d '\\n' ripdrag -r -x -a -s 64 -H 500 -b -W 420"
icon-theme = "tabler-icons"
icon = "outline/screenshot.svg"
angle = 3

[[menu.items.items]]
label = "Hypr Picker"
command = "sleep 0.5 ; hyprpicker -a -l"
icon-theme = "tabler-icons"
icon = "outline/color-picker.svg"
angle = 157

[[menu.items.items]]
label = "Screen Records"
command = "ls -dt /home/rywby/Videos/Screen-Record/* | xargs -d '\\n' ripdrag -r -x -a -s 64 -H 500 -b -W 420"
icon-theme = "simple-icons"
icon = "screencastify.svg"
angle = 209

[[menu.items]]
label = "Apps"
icon-theme = "tabler-icons"
icon = "outline/grid-dots.svg"
angle = 72

[[menu.items.items]]
label = "Calc"
command = "qalculate-qt"
icon-theme = "tabler-icons"
icon = "filled/calculator.svg"
angle = 72

[[menu.items.items]]
label = "Libre Office"
command = "libreoffice"
icon-theme = "simple-icons"
icon = "libreoffice.svg"
angle = 27

[[menu.items.items]]
label = "Only Office"
command = "flatpak run org.onlyoffice.desktopeditors"
icon-theme = "simple-icons"
icon = "onlyoffice.svg"
angle = 117

[[menu.items.items]]
label = "Kdenlive"
command = "flatpak run org.kde.kdenlive"
icon-theme = "simple-icons"
icon = "kdenlive.svg"
angle = 162

[[menu.items.items]]
label = "Bambu Studio"
command = "flatpak run com.bambulab.BambuStudio"
icon-theme = "simple-icons"
icon = "bambulab.svg"
angle = 342

[[menu.items.items]]
label = "Vencord"
command = "flatpak run dev.vencord.Vesktop"
icon-theme = "simple-icons"
icon = "vencord.svg"
angle = 207

[[menu.items.items]]
label = "Steam"
command = "flatpak run com.valvesoftware.Steam"
icon-theme = "simple-icons"
icon = "steam.svg"
angle = 297

[[menu.items]]
label = "FPV"
icon-theme = "tabler-icons"
icon = "outline/propeller.svg"
angle = 144

[[menu.items.items]]
label = "Beta Flight"
command = "chromium --test-type 'https://app.betaflight.com/'"
angle = 108

[[menu.items.items]]
label = "ESC Config"
command = "chromium --test-type 'esc-configurator.com'"
angle = 252

[[menu.items.items]]
label = "Chrom ium"
command = "chromium --test-type"
icon-theme = "simple-icons"
icon = "googlechrome.svg"
angle = 36

[[menu.items.items]]
label = "AM32"
command = "chromium --test-type 'am32.ca'"
angle = 180

[[menu.items]]
label = "2Apps"
icon-theme = "simple-icons"
icon = "polkadot.svg"
angle = 216

[[menu.items.items]]
label = "Nwg Look"
command = "nwg-look"
icon-theme = "simple-icons"
icon = "gtk.svg"
angle = 276

[[menu.items.items]]
label = "Kvantum Manager"
command = "kvantummanager"
icon-theme = "simple-icons"
icon = "qt.svg"
angle = 336

[[menu.items.items]]
label = "Audacious"
command = "audacious -t"
icon-theme = "tabler-icons"
icon = "outline/file-music.svg"
angle = 156

[[menu.items.items]]
label = "Emoji"
command = "flatpak run it.mijorus.smile"
icon-theme = "simple-icons"
icon = "smugmug.svg"
angle = 96

[[menu.items.items]]
label = "Screen Record"
icon-theme = "tabler-icons"
icon = "outline/screen-share.svg"
angle = 214

[[menu.items.items.items]]
label = "eDP-1"
command = "notify-send 'gpu-screen-recorder' 'eDP-1 audio+mic' && gpu-screen-recorder -w eDP-1 -k h264 -bm qp -q medium -a alsa_input.pci-0000_03_00.6.HiFi__Mic1__source -o ~/Videos/Screen-Record/eDP-1-$(date +%Y-%m-%d_%H-%M-%S).mp4"
angle = 178

[[menu.items.items.items]]
label = "HDMI- -A-1"
command = "notify-send 'gpu-screen-recorder' 'HDMI-A-1 audio+mic' && gpu-screen-recorder -w HDMI-A-1 -k h264 -bm qp -q medium -a alsa_input.pci-0000_03_00.6.HiFi__Mic1__source -o ~/Videos/Screen-Record/HDMI-A-1-$(date +%Y-%m-%d_%H-%M-%S).mp4"
angle = 322

[[menu.items.items.items]]
label = "Stop Record"
command = "pkill -f gpu-screen-recorder & notify-send 'gpu-screen-recorder' 'stop recording'"
icon-theme = "tabler-icons"
icon = "outline/hand-stop.svg"
angle = 250

[[menu.items.items.items]]
label = "Obs"
command = "obs"
icon-theme = "simple-icons"
icon = "obsstudio.svg"
angle = 106

[[menu.items]]
label = "System"
icon-theme = "Papirus-Dark"
icon = "16x16/devices/system.svg"
angle = 0

[[menu.items.items]]
label = "Config"
command = "waypie-config"
icon-theme = "Papirus-Dark"
icon = "16x16/actions/rabbitvcs-settings.svg"
angle = 252

[[menu.items.items]]
label = "Power"
icon-theme = "tabler-icons"
icon = "outline/battery-vertical-exclamation.svg"
angle = 108

[[menu.items.items.items]]
label = "Reboot"
command = "loginctl reboot"
icon-theme = "Papirus-Dark"
icon = "16x16/actions/system-reboot.svg"
angle = 353

[[menu.items.items.items]]
label = "Quit"
command = "driftwm msg action quit"
icon-theme = "tabler-icons"
icon = "outline/door-exit.svg"
angle = 108

[[menu.items.items.items]]
label = "Power Off"
command = "loginctl poweroff"
icon-theme = "tabler-icons"
icon = "outline/power.svg"
angle = 223

[[menu.items.items]]
label = "Sleep"
command = "swaylock -f -c 000000 -kl & sleep 1 && loginctl suspend"
icon-theme = "tabler-icons"
icon = "outline/zzz.svg"
angle = 36

[[menu.items.items]]
label = "lock"
command = "swaylock -f -c 000000 -kl"
icon-theme = "Papirus-Dark"
icon = "16x16/actions/object-locked.svg"
angle = 324
