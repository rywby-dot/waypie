menu-radius = 120
center-hitbox-size = 160
minimum-edge-distance = 200
center-mode = false
close-submenu-on-center-click = false
hover-mode = false
turbo-mode = true
hold-to-turbo = true
travel-item-animation = true
preserve-proportions = false
auto-alignment = true
configurator-show-icons = true

[menu]
label = "Waypie"
icon-theme = "simple-icons"
icon = "roamresearch.svg"

[[menu.items]]
label = "Scripts"
icon-theme = "simple-icons"
icon = "scrollreveal.svg"
angle = 288

[[menu.items.items]]
label = "Driftwm Config"
command = "footclient env QUIET_START=1 zsh -ic 'nvim ~/.config/driftwm/config.toml; unset QUIET_START'"
icon-theme = "tabler-icons"
icon = "filled/adjustments-horizontal.svg"
angle = 55

[[menu.items.items]]
label = "Driftwm State"
command = "footclient zsh -c 'cat $XDG_RUNTIME_DIR/driftwm/state; exec zsh'"
icon-theme = "tabler-icons"
icon = "filled/list-details.svg"
angle = 260

[[menu.items.items]]
label = "Fetch"
command = "footclient -a foot-ff zsh -c 'fastfetch -c screenfetch.jsonc && sleep 9999'"
icon-theme = "tabler-icons"
icon = "outline/info-circle.svg"
angle = 312

[[menu.items.items]]
label = "Screen Shots"
command = "ls -dt /home/rywby/Pictures/Screenshots/* | xargs -d '\\n' ripdrag -r -x -a -s 64 -H 500 -b -W 420"
icon-theme = "tabler-icons"
icon = "outline/screenshot.svg"
angle = 3

[[menu.items.items]]
label = "Hypr Picker"
command = "sleep 0.5 ; hyprpicker -a -l"
icon-theme = "tabler-icons"
icon = "outline/color-picker.svg"
angle = 157

[[menu.items.items]]
label = "Screen Records"
command = "ls -dt /home/rywby/Videos/Screen-Record/* | xargs -d '\\n' ripdrag -r -x -a -s 64 -H 500 -b -W 420"
icon-theme = "simple-icons"
icon = "screencastify.svg"
angle = 209

